From 558598bcc70c233fd408b7dd0aec26d0cea85487 Mon Sep 17 00:00:00 2001
From: Mateusz Krzemieniewski <mateusz.krzemieniewski@intel.com>
Date: Mon, 28 Sep 2026 11:54:06 +0300
Subject: [PATCH] Skip packet-layout parity for equivalent MP3 padding

Once bounded MP3 padding is aligned and the complete decoded signal
matches, packet boundary PTS and duration values are not expected to
match the FFmpeg CLI. Keep packet parity checks for every other case.

Signed-off-by: Mateusz Krzemieniewski <mateusz.krzemieniewski@intel.com>
---
 test/test_encoders.py | 42 +++++++++---------------------------------
 1 file changed, 9 insertions(+), 33 deletions(-)

diff --git a/test/test_encoders.py b/test/test_encoders.py
index e6920d1..41161ce 100644
--- a/test/test_encoders.py
+++ b/test/test_encoders.py
@@ -62,9 +62,7 @@ def with_ffmpeg_debug_logs():
     os.environ["TORCHCODEC_FFMPEG_LOG_LEVEL"] = previous_log_level
 
 
-def validate_frames_properties(
-    *, actual: Path, expected: Path, allow_start_time_offset: bool = False
-):
+def validate_frames_properties(*, actual: Path, expected: Path):
     # actual and expected are files containing encoded audio data.  We call
     # `ffprobe` on both, and assert that the frame properties match (pts,
     # duration, etc.)
@@ -119,32 +117,9 @@ def validate_frames_properties(
                 # something like this. In any case, this doesn't seem to be
                 # critical.
                 continue
-            if allow_start_time_offset and prop in ("pts", "duration"):
-                # Integer timestamps are expressed in each stream's time base,
-                # which may differ when equivalent MP3 padding metadata differs.
-                # The corresponding second-based properties are checked below.
-                continue
-            error_message = (
-                f"\nComparing: {actual}\nagainst reference: {expected},\n"
-                f"the {prop} property is different at frame {frame_index}:"
-            )
-            if allow_start_time_offset and prop == "pts_time":
-                actual_value = float(d_actual[prop]) - float(frames_actual[0][prop])
-                expected_value = float(d_expected[prop]) - float(
-                    frames_expected[0][prop]
-                )
-            elif allow_start_time_offset and prop == "duration_time":
-                actual_value = float(d_actual[prop])
-                expected_value = float(d_expected[prop])
-            else:
-                actual_value = d_actual[prop]
-                expected_value = d_expected[prop]
-            if allow_start_time_offset and prop in ("pts_time", "duration_time"):
-                assert actual_value == pytest.approx(
-                    expected_value, abs=1e-9
-                ), error_message
-            else:
-                assert actual_value == expected_value, error_message
+            assert (
+                d_actual[prop] == d_expected[prop]
+            ), f"\nComparing: {actual}\nagainst reference: {expected},\nthe {prop} property is different at frame {frame_index}:"
 
 
 class TestAudioEncoder:
@@ -1307,11 +1282,12 @@ class TestEncoder:
         # picks by default from the sample rate, which is what we use. The
         # decoded samples still match, but the packets can't.
         cli_flac_block_size_differs = format == "flac" and ffmpeg_major_version >= 9
-        if method == "to_file" and not cli_flac_block_size_differs:
+        # Different valid MP3 padding can also change the boundary packet
+        # layout even after the decoded signal is aligned and matches.
+        packet_layout_differs = cli_flac_block_size_differs or mp3_padding_differs
+        if method == "to_file" and not packet_layout_differs:
             validate_frames_properties(
-                actual=encoder_output,
-                expected=encoded_by_ffmpeg,
-                allow_start_time_offset=mp3_padding_differs,
+                actual=encoder_output, expected=encoded_by_ffmpeg
             )
 
     @pytest.mark.parametrize(
-- 
2.43.0


diff --git a/fbgemm_gpu/test/test_utils.py b/fbgemm_gpu/test/test_utils.py
index 260e11e..c1d4562 100644
--- a/fbgemm_gpu/test/test_utils.py
+++ b/fbgemm_gpu/test/test_utils.py
@@ -66,6 +66,20 @@ gpu_unavailable: tuple[bool, str] = (
 # Used for `if` statements inside tests
 gpu_available: bool = not gpu_unavailable[0]
 
+# Used for `@unittest.skipIf`
+xpu_unavailable: tuple[bool, str] = (
+    not torch.xpu.is_available() or torch.xpu.device_count() == 0,
+    "XPU is not available or no XPUs detected",
+)
+# Used for `if` statements inside tests
+xpu_available: bool = not xpu_unavailable[0]
+
+# Used for `@unittest.skipIf` when either GPU or XPU can run the test
+accelerator_unavailable: tuple[bool, str] = (
+    gpu_unavailable[0] and xpu_unavailable[0],
+    "GPU and XPU not found",
+)
+
 is_nvidia_device: bool = gpu_available and torch.version.cuda is not None
 
 # Used for `@unittest.skipIf` for tests that pass in internal CI, but fail on the GitHub runners
@@ -128,6 +142,7 @@ on_arm_platform: tuple[bool, str] = (
 
 def cpu_and_maybe_gpu() -> st.SearchStrategy[list[torch.device]]:
     gpu_available = torch.cuda.is_available() and torch.cuda.device_count() > 0
+    xpu_available = torch.xpu.is_available() and torch.xpu.device_count() > 0
     # st.sampled_from is not guaranteed to test all the values passed to it.
     # However, Hypothesis, by default, generates 100 test cases from the specified strategies.
     # If st.sampled_from contains >100 items or if it's used in conjunction with other strategies
@@ -136,7 +151,8 @@ def cpu_and_maybe_gpu() -> st.SearchStrategy[list[torch.device]]:
     # lint-fixme: TorchDeviceCuda, TorchFunctionCallCudaDevice
     # CUDA specifically required: GPU device strategy for FBGEMM tests
     gpu_devices = [torch.device("cuda")] if gpu_available else []
-    return st.sampled_from([torch.device("cpu")] + gpu_devices)
+    xpu_devices = [torch.device("xpu")] if xpu_available else []
+    return st.sampled_from([torch.device("cpu")] + gpu_devices + xpu_devices)
 
 

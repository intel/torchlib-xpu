From a848171e0a9848479feff5f755bb47833c392b8c Mon Sep 17 00:00:00 2001
From: Mateusz Krzemieniewski <mateusz.krzemieniewski@intel.com>
Date: Mon, 28 Sep 2026 13:37:06 +0300
Subject: [PATCH] Handle MP3 padding in audio encoder parity tests

libmp3lame 3.101 can represent equivalent boundary padding with
different decoded lengths and packet layouts. Align less than one MP3
frame only when the full decoded signal still matches, and retain strict
packet parity for every unaffected case.

Signed-off-by: Mateusz Krzemieniewski <mateusz.krzemieniewski@intel.com>
---
 test/test_encoders.py | 65 ++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 58 insertions(+), 7 deletions(-)

diff --git a/test/test_encoders.py b/test/test_encoders.py
index 91ce859..41161ce 100644
--- a/test/test_encoders.py
+++ b/test/test_encoders.py
@@ -1219,12 +1219,60 @@ class TestEncoder:
         else:
             rtol, atol = None, None
 
-        assert_close(
-            samples_by_us.data,
-            samples_by_ffmpeg.data,
-            rtol=rtol,
-            atol=atol,
-        )
+        samples_by_us_data = samples_by_us.data
+        samples_by_ffmpeg_data = samples_by_ffmpeg.data
+        mp3_padding_differs = (
+            samples_by_us_data.shape != samples_by_ffmpeg_data.shape
+        )
+        if mp3_padding_differs:
+            # MP3 encoders may report different leading or trailing padding
+            # while preserving the same decoded signal. Accept less than one
+            # MP3 frame only when removing it makes every remaining sample
+            # pass the normal comparison below.
+            assert format == "mp3"
+            assert (
+                samples_by_us_data.shape[:-1] == samples_by_ffmpeg_data.shape[:-1]
+            )
+            num_padding_samples = abs(
+                samples_by_us_data.shape[-1] - samples_by_ffmpeg_data.shape[-1]
+            )
+            mp3_frame_size = 1_152 if sample_rate >= 32_000 else 576
+            assert 0 < num_padding_samples < mp3_frame_size
+
+            if samples_by_us_data.shape[-1] > samples_by_ffmpeg_data.shape[-1]:
+                longer, shorter = samples_by_us_data, samples_by_ffmpeg_data
+                longer_is_ours = True
+            else:
+                longer, shorter = samples_by_ffmpeg_data, samples_by_us_data
+                longer_is_ours = False
+
+            last_error = None
+            for aligned_longer in (
+                longer[..., num_padding_samples:],
+                longer[..., :-num_padding_samples],
+            ):
+                actual, expected = (
+                    (aligned_longer, shorter)
+                    if longer_is_ours
+                    else (shorter, aligned_longer)
+                )
+                try:
+                    assert_close(actual, expected, rtol=rtol, atol=atol)
+                    break
+                except AssertionError as error:
+                    last_error = error
+            else:
+                raise AssertionError(
+                    "MP3 padding differed, but neither leading nor trailing "
+                    "alignment produced equivalent decoded samples."
+                ) from last_error
+        else:
+            assert_close(
+                samples_by_us_data,
+                samples_by_ffmpeg_data,
+                rtol=rtol,
+                atol=atol,
+            )
         assert samples_by_us.sample_rate == samples_by_ffmpeg.sample_rate
 
         # On FFmpeg >= 9 the CLI encodes FLAC with a block size equal to the
@@ -1234,7 +1282,10 @@ class TestEncoder:
         # picks by default from the sample rate, which is what we use. The
         # decoded samples still match, but the packets can't.
         cli_flac_block_size_differs = format == "flac" and ffmpeg_major_version >= 9
-        if method == "to_file" and not cli_flac_block_size_differs:
+        # Different valid MP3 padding can also change the boundary packet
+        # layout even after the decoded signal is aligned and matches.
+        packet_layout_differs = cli_flac_block_size_differs or mp3_padding_differs
+        if method == "to_file" and not packet_layout_differs:
             validate_frames_properties(
                 actual=encoder_output, expected=encoded_by_ffmpeg
             )
-- 

diff --git a/fbgemm_gpu/test/conftest.py b/fbgemm_gpu/test/conftest.py
new file mode 100644
index 000000000..760273ce5
--- /dev/null
+++ b/fbgemm_gpu/test/conftest.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 Intel Corporation. All Rights Reserved.
+# SPDX-License-Identifier: BSD-3-Clause
+
+# pyre-strict
+
+"""
+Pytest conftest for the FBGEMM test suite.
+
+When the environment ships `fbgemm-gpu-cpu` (CPU wheel) together with
+`fbgemm-xpu` (XPU op registrations), the installed
+`fbgemm_gpu.tbe.utils.common.to_device` falls through to `t.to("mtia")` for
+`use_cpu=False` because `torch.cuda.is_available()` is False.  That crashes with
+`AssertionError: Torch not compiled with MTIA enabled`.
+
+Monkey-patch `to_device` (and its re-exported binding) so that XPU is picked as
+the accelerator when CUDA is unavailable.  This runs before pytest imports any
+test module, so the freshly-patched function is what test files bind when they
+execute `from fbgemm_gpu.tbe.utils import to_device`.
+
+Also import `fbgemm_xpu` best-effort so the XPU dispatch table is populated
+before tests run.
+"""
+import torch
+
+# Register XPU (Intel GPU) FBGEMM operator implementations, if available.
+try:
+    import fbgemm_xpu  # noqa: F401
+except ImportError:
+    pass
+
+
+def _install_xpu_to_device_shim() -> None:
+    if not (hasattr(torch, "xpu") and torch.xpu.is_available()):
+        return
+    if torch.cuda.is_available():
+        # Preserve CUDA behaviour when both are present.
+        return
+
+    import fbgemm_gpu.tbe.utils as _tbe_utils
+    import fbgemm_gpu.tbe.utils.common as _tbe_common
+    import fbgemm_gpu.tbe.utils.offsets as _tbe_offsets
+    import fbgemm_gpu.tbe.utils.quantize as _tbe_quantize
+
+    _original_to_device = _tbe_common.to_device
+
+    def to_device(t, use_cpu):  # noqa: ANN001, ANN201
+        if use_cpu:
+            return t.cpu()
+        if torch.cuda.is_available():
+            return t.cuda()
+        return t.to(device="xpu")
+
+    to_device.__doc__ = (
+        "XPU-aware replacement installed by fbgemm_gpu/test/conftest.py.\n"
+        "Routes non-CPU tensors to XPU when CUDA is unavailable."
+    )
+    # pyre-ignore[16]: attribute assignment on module.
+    to_device._original = _original_to_device
+
+    _tbe_common.to_device = to_device
+    _tbe_utils.to_device = to_device
+    _tbe_offsets.to_device = to_device
+    _tbe_quantize.to_device = to_device
+
+
+_install_xpu_to_device_shim()

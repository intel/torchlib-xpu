@@ -35,6 +39,7 @@ else:
         gpu_unavailable,
         on_oss_clang,
         optests,
+        xpu_available,
     )
 
 
@@ -111,6 +116,18 @@ class ExpandIntoJaggedPermuteTest(unittest.TestCase):
                 output_permute_gpu.cpu(), output_permute_ref_tensor
             )
 
+        if xpu_available:
+            # xpu op
+            output_permute_xpu = torch.ops.fbgemm.expand_into_jagged_permute(
+                permute_tensor.xpu(),
+                offsets_1d_tensor.xpu(),
+                permuted_offsets_1d_tensor.xpu(),
+                offsets_1d[-1],
+            )
+            torch.testing.assert_close(
+                output_permute_xpu.cpu(), output_permute_ref_tensor
+            )
+
     @unittest.skipIf(*gpu_unavailable)
     # Skip on GPUs with insufficient HBM. Inputs are int32 of size
     # ~permute_size, totaling ~1.5 GiB at the chosen permute_size.

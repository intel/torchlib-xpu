+
+# XPU-only environments (fbgemm-gpu-cpu + fbgemm-xpu).  The base
+# `SplitTableBatchedEmbeddingBagsCodegen` has no `ComputeDevice.XPU` code path,
+# so build the module in CPU mode and relocate all buffers/parameters to XPU
+# after construction.  Only the no-bag / row-wise Adagrad pt2 kernel is
+# implemented on XPU today; `execute_backward_adagrad` filters unsupported
+# combinations via `assume(...)`.
+_XPU_ONLY: bool = xpu_available and not cuda_available
+
+
+if _XPU_ONLY:
+
+    class _SplitCodegenForXPU(SplitTableBatchedEmbeddingBagsCodegen):
+        def __init__(self, *args, **kwargs) -> None:
+            # Force CPU construction (no CUDA calls, HOST placement).
+            if "embedding_specs" in kwargs:
+                embedding_specs = kwargs.pop("embedding_specs")
+            elif args:
+                embedding_specs = args[0]
+                args = args[1:]
+            else:
+                raise TypeError(
+                    "_SplitCodegenForXPU requires `embedding_specs`"
+                )
+            cpu_specs = [
+                (E, D, EmbeddingLocation.HOST, ComputeDevice.CPU)
+                for (E, D, _M, _C) in embedding_specs
+            ]
+            # `bounds_check_indices` has no XPU kernel; disable to avoid the
+            # NotImplementedError in `SplitTableBatchedEmbeddingBagsCodegen.
+            # prepare_inputs()`.  Callers may override by passing an explicit
+            # `bounds_check_mode` kwarg.
+            kwargs.setdefault("bounds_check_mode", BoundsCheckMode.NONE)
+            super().__init__(cpu_specs, *args, **kwargs)
+
+            # Reshape the CPU/HOST buffer layout into the DEVICE layout the
+            # invoker expects for XPU (5-tensor weights list where index 0 is
+            # `weights_dev` on the accelerator).  Move the actual data from
+            # `weights_host` into `weights_dev` on XPU, zero out the HOST
+            # buffer so `host_weights.numel() == 0`, and flip the placement
+            # markers from HOST (=3) to DEVICE (=0).
+            xpu = torch.device("xpu")
+
+            def _reshape_pair(host_name: str, dev_name: str) -> None:
+                host_t = getattr(self, host_name)
+                dev_t = getattr(self, dev_name)
+                is_param = isinstance(host_t, torch.nn.Parameter)
+                if host_t is not None and host_t.numel() > 0:
+                    new_dev = host_t.detach().to(xpu).clone()
+                    new_host = torch.empty(
+                        0, dtype=host_t.dtype, device=xpu
+                    )
+                    if is_param:
+                        # `weights_host` / `momentum1_host` are declared as
+                        # `nn.Parameter`; the corresponding *_dev slots are
+                        # too.  Wrap to keep type-compatibility.
+                        new_dev = torch.nn.Parameter(
+                            new_dev, requires_grad=host_t.requires_grad
+                        )
+                        new_host = torch.nn.Parameter(
+                            new_host, requires_grad=host_t.requires_grad
+                        )
+                    setattr(self, dev_name, new_dev)
+                    setattr(self, host_name, new_host)
+                elif dev_t is not None:
+                    moved = dev_t.to(xpu)
+                    if isinstance(dev_t, torch.nn.Parameter):
+                        moved = torch.nn.Parameter(
+                            moved, requires_grad=dev_t.requires_grad
+                        )
+                    setattr(self, dev_name, moved)
+
+            _reshape_pair("weights_host", "weights_dev")
+            _reshape_pair("momentum1_host", "momentum1_dev")
+
+            # Move remaining tensor attributes onto XPU and flip placements.
+            for name in (
+                "weights_uvm",
+                "lxu_cache_weights",
+                "weights_offsets",
+                "momentum1_uvm",
+                "momentum1_offsets",
+                "hash_size_cumsum",
+                "D_offsets",
+                "rows_per_table",
+                "bounds_check_warning",
+                # Note: `learning_rate_tensor` must stay on CPU per the
+                # kernel contract (see comment in test_utils.py).  Leave it.
+                # Plain (non-registered) attributes that are initialised on
+                # `self.current_device` at construction time; the base class
+                # created them on CPU, so move them onto XPU now.
+                "lxu_cache_locations_empty",
+                "lxu_cache_locations",
+                "_indices",
+                "_offsets",
+                "_vbe_B_offsets",
+            ):
+                t = getattr(self, name, None)
+                if isinstance(t, torch.Tensor) and t.device.type != "xpu":
+                    setattr(self, name, t.to(xpu))
+
+            # `placeholder_autograd_tensor` is a Parameter; keep the wrapper.
+            pat = getattr(self, "placeholder_autograd_tensor", None)
+            if isinstance(pat, torch.Tensor) and pat.device.type != "xpu":
+                self.placeholder_autograd_tensor = torch.nn.Parameter(
+                    pat.detach().to(xpu),
+                    requires_grad=pat.requires_grad,
+                )
+
+            for placements_name in (
+                "weights_placements",
+                "momentum1_placements",
+            ):
+                p = getattr(self, placements_name, None)
+                if isinstance(p, torch.Tensor):
+                    setattr(
+                        self,
+                        placements_name,
+                        torch.full_like(
+                            p, int(EmbeddingLocation.DEVICE), device=xpu
+                        ),
+                    )
+
+            # `split_embedding_weights()` uses the Python list attribute
+            # `weights_physical_placements` (not the tensor above) to select
+            # `weights_dev` / `weights_host` / `weights_uvm`; keep them in
+            # lock-step with the tensor placements.
+            if hasattr(self, "weights_physical_placements"):
+                self.weights_physical_placements = [
+                    EmbeddingLocation.DEVICE
+                    for _ in self.weights_physical_placements
+                ]
+            # Same for `split_optimizer_states()`.
+            if hasattr(self, "momentum1_physical_placements"):
+                self.momentum1_physical_placements = [
+                    EmbeddingLocation.DEVICE
+                    for _ in self.momentum1_physical_placements
+                ]
+
+            # pyre-ignore[16]: attribute defined on the base class.
+            self.current_device = xpu
+            self.use_cpu = False
+            self.use_mtia = False
+
 VERBOSITY: Verbosity = Verbosity.verbose
 
 common_strategy: dict[str, Any] = {
@@ -153,7 +302,35 @@ def execute_backward_adagrad(  # noqa C901
     # Disable dynamo tests due to unknown failure
     assume(not compile)
 
+    # XPU only implements no-bag / unweighted / non-VBE / non-GWD / uniform-B
+    # rowwise Adagrad without cache, stochastic rounding, weight decay or
+    # max-norm.  Filter unsupported combos out of the hypothesis space.
+    if _XPU_ONLY and not use_cpu:
+        assume(pooling_mode == PoolingMode.NONE)
+        assume(row_wise)
+        assume(not weighted)
+        assume(not mixed)
+        assume(not mixed_B)
+        assume(not use_cache)
+        assume(not stochastic_rounding)
+        assume(weight_decay_mode == WeightDecayMode.NONE)
+        assume(max_norm == 0.0)
+
+    # In the XPU-only environment `use_cpu_strategy()` is broadened to
+    # `booleans()` (Phase 1) so tests now sample `use_cpu=True` cases too.
+    # The CPU wheel does not implement BF16 for the no-bag forward
+    # (`split_embedding_nobag_cpu_forward_1`), so filter that combo out.
+    if _XPU_ONLY and use_cpu:
+        assume(
+            not (
+                pooling_mode == PoolingMode.NONE
+                and output_dtype == SparseType.BF16
+            )
+        )
+
     emb_op = SplitTableBatchedEmbeddingBagsCodegen
+    if _XPU_ONLY and not use_cpu:
+        emb_op = _SplitCodegenForXPU
 
     if pooling_mode == PoolingMode.SUM:
         mode = "sum"
@@ -216,6 +393,12 @@ def execute_backward_adagrad(  # noqa C901
     elif use_cpu:
         managed = [EmbeddingLocation.HOST] * T
         compute_device = ComputeDevice.CPU
+    elif _XPU_ONLY:
+        # XPU tensors always live on device; `ComputeDevice.CPU` is only used
+        # as a stand-in for the constructor - the `_SplitCodegenForXPU` shim
+        # relocates every tensor to XPU right after construction.
+        managed = [EmbeddingLocation.DEVICE] * T
+        compute_device = ComputeDevice.CPU
     elif TEST_WITH_ROCM:
         # ROCm managed memory allocation is under development
         managed = [EmbeddingLocation.DEVICE] * T
@@ -489,6 +672,12 @@ def execute_backward_adagrad(  # noqa C901
     if tbe_op:
         return
 
+    # The per-sample-weights + gradcheck sub-block that follows re-instantiates
+    # the codegen module with `PoolingMode.SUM` (weighted route), which is not
+    # implemented on XPU.  Skip the remainder of the function on XPU.
+    if _XPU_ONLY and not use_cpu:
+        return
+
     # Free large tensors no longer needed before gradcheck to reduce GPU memory pressure
     del bs, bs_features, fs, gos, goc, fc2, ref_output
     del split_optimizer_states, get_optimizer_states, xs, xws
@@ -563,7 +752,7 @@ def execute_backward_adagrad(  # noqa C901
     y.sum().backward()
     indice_weight_grad_mask = per_sample_weights.grad.clone().cpu()
 
-    if gpu_available and not TEST_WITH_ROCM:
+    if cuda_available and not TEST_WITH_ROCM:
         torch.cuda.synchronize()
 
     acc_B = 0
